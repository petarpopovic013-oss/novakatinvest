# Novak Invest - cPanel / Apache Configuration

RewriteEngine On

# One canonical HTTPS and non-www hostname
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.novakinvest\.rs(?::\d+)?$ [NC]
RewriteRule ^ https://novakinvest.rs%{REQUEST_URI} [R=301,L,NE]

# Preserve search authority from the previous website
RewriteRule ^atrium-residence/?$ /reference/atrium-residence/ [R=301,L]
RewriteRule ^atrium-residence-lokacija/?$ /reference/atrium-residence/ [R=301,L]
RewriteRule ^gunduliceva-33/?$ /reference/gunduliceva-33/ [R=301,L]
RewriteRule ^gunduliceve-33-lokacija/?$ /reference/gunduliceva-33/ [R=301,L]
RewriteRule ^prodaja-stanova-atrium-residence(?:/.*)?$ /reference/atrium-residence/ [R=301,L]
RewriteRule ^prodaja-stanova-gunduliceva(?:/.*)?$ /reference/gunduliceva-33/ [R=301,L]
RewriteRule ^sremska-kamenica-(projekat|lokacija)/?$ /ponuda/sremska-kamenica-zmaj-jovina-25/ [R=301,L]
RewriteRule ^sremska-kamenica/?$ /ponuda/sremska-kamenica-zmaj-jovina-25/ [R=301,L]
RewriteRule ^petrovaradin-(projekat|lokacija)/?$ /ponuda/petrovaradin-vladimira-gortana-8c/ [R=301,L]
RewriteRule ^petrovaradin/?$ /ponuda/petrovaradin-vladimira-gortana-8c/ [R=301,L]
RewriteRule ^temerinska(-projekat|-lokacija)?/?$ /ponuda/temerinska-143/ [R=301,L]
RewriteRule ^ponuda/temerinska-141/?$ /ponuda/temerinska-143/ [R=301,L]
RewriteRule ^projekti/?$ /ponuda/ [R=301,L]
RewriteRule ^prodaja-stanova/?$ /ponuda/ [R=301,L]

RewriteCond %{QUERY_STRING} (^|&)page_id=5086(&|$) [NC]
RewriteRule ^$ /reference/atrium-residence/ [R=301,L,NE,QSD]

# Remove indexed spam/archive URLs left by the previous WordPress site
RewriteRule ^(category|tag|author)(/|$) - [G,L]

# Custom 404 Error Document
ErrorDocument 404 /_not-found/index.html

# Enable Gzip Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json application/pdf image/svg+xml font/woff2
</IfModule>

# Browser Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType application/pdf "access plus 1 month"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Force PDF Downloads
<IfModule mod_headers.c>
  <FilesMatch "\.pdf$">
    Header set Content-Disposition "attachment"
  </FilesMatch>
</IfModule>
